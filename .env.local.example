# Preenchido automaticamente por `vercel env pull .env.local` após o provisionamento.
# Postgres serverless (Neon via integração do Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Segredo para assinar o cookie de sessão (scrypt + HMAC). Gerar com: openssl rand -hex 32
SESSION_SECRET=

# Locale padrão da aplicação (pt | en)
NEXT_PUBLIC_DEFAULT_LOCALE=pt

# Base pública do site (usada em metadados/OG)
NEXT_PUBLIC_SITE_URL=https://neovoto.vercel.app

# Token gratuito do brasil.io (dataset eleicoes-brasil) — busca de candidatos por nome.
# Crie em https://brasil.io/auth/tokens-api/
BRASILIO_API_TOKEN=

# Base dos Dados via BigQuery — espelho COMPLETO do TSE (votação por município/seção,
# todos os cargos, inclui 2024). Ver docs/DADOS-TSE.md §4 para o passo a passo.
# GCP_PROJECT_ID = id do seu projeto no Google Cloud (billing das queries; cota grátis 1TB/mês)
# GCP_SERVICE_ACCOUNT_KEY = o JSON inteiro da service account (papel "BigQuery Job User"), numa linha
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=
