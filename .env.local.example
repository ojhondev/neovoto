# Preenchido automaticamente por `vercel env pull .env.local` após o provisionamento.
# Postgres serverless (Neon via integração do Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Segredo para assinar o cookie de sessão (scrypt + HMAC). Gerar com: openssl rand -hex 32
SESSION_SECRET=

# Locale padrão da aplicação (pt | en)
NEXT_PUBLIC_DEFAULT_LOCALE=pt

# Base pública do site (usada em metadados/OG)
NEXT_PUBLIC_SITE_URL=https://neovoto.vercel.app

# Token gratuito do brasil.io (dataset eleicoes-brasil) — habilita busca de candidatos
# em TODOS os cargos e a camada de votação por município. Ver docs/DADOS-TSE.md.
# Crie em https://brasil.io/auth/tokens-api/
BRASILIO_API_TOKEN=
